    "cheerio": "^1.0.0-rc.3",
    "eslint": "^7.32.0",
    "eslint-plugin-sort-keys-custom": "^2.0.0",
    "marked": "^2.0.0",
    "prettier": "2.4.1",
    "simple-git": "^2.42.0",
    "typescript": "^4.3.5"
  }
